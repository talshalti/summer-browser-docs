{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://summerbrowser.com/schemas/public-release-manifest-v2.json",
  "title": "Summer Browser public release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "platform", "version", "sourceCommit", "assets"],
  "properties": {
    "schemaVersion": {"const": 2},
    "platform": {"enum": ["windows", "macos", "android"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runtimeVerification": {
      "description": "An explicit release-owner waiver for absent Intel runtime evidence, bound to this macOS artifact and source.",
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactSha256", "sourceCommit", "arm64", "x86_64", "reason"],
      "properties": {
        "artifactSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "arm64": {"const": "passed"},
        "x86_64": {"const": "waived-by-explicit-release-authorization"},
        "reason": {"const": "Intel runtime testing explicitly waived by the release owner; no Intel runtime pass is claimed."}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "kind", "name", "bytes", "sha256"],
        "properties": {
          "platform": {"enum": ["windows", "macos", "android"]},
          "kind": {"type": "string", "minLength": 1},
          "name": {"type": "string", "pattern": "^[^/\\\\]+$"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "signature": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["runtimeVerification"]},
      "then": {"properties": {"platform": {"const": "macos"}}}
    }
  ]
}
