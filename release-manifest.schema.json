{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://summerbrowser.com/schemas/public-release-manifest-v2.json",
  "title": "Summer Browser public release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "platform", "version", "sourceCommit", "assets"],
  "properties": {
    "schemaVersion": {"const": 2},
    "platform": {"enum": ["windows", "macos", "android"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "kind", "name", "bytes", "sha256"],
        "properties": {
          "platform": {"enum": ["windows", "macos", "android"]},
          "kind": {"type": "string", "minLength": 1},
          "name": {"type": "string", "pattern": "^[^/\\\\]+$"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "signature": {"type": "string"}
        }
      }
    }
  }
}
